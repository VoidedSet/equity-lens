# Storage backend: local | s3
STORAGE_BACKEND=local
LOCAL_DATALAKE_DIR=./local_datalake
S3_BUCKET=equity-lens-datalake-dev
AWS_REGION=ap-south-1

# LLM provider: featherless | bedrock | mock
LLM_PROVIDER=featherless
BEDROCK_REGION=ap-south-1
# Presets or exact Bedrock model/inference-profile ID:
# - gemma3-27b       (google.gemma-3-27b-it)
# - mistral-large-3  (mistral.mistral-large-3-675b-instruct)
# - llama3-3-70b     (meta.llama3-3-70b-instruct-v1:0)
BEDROCK_MODEL_ID=google.gemma-3-27b-it
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
GEMMA_MODEL=google/gemma-3-27b-it

# Output sink: s3 | supabase | none
SINK=s3
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Embeddings & chunking
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_CHARS=3000
CHUNK_OVERLAP_CHARS=400
CHUNKS_PER_BATCH=5
